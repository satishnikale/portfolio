# Public URL of the deployed site. Used for canonical URLs, Open Graph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. A form endpoint that accepts a JSON POST of { name, email, phone, subject, message } (e.g. Formspree: https://formspree.io/f/<id>).
# When unset, the contact form falls back to opening the visitor's email client (mailto).
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
